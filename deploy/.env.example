# =====================================================================
# VotreTour — configuration du serveur
# ---------------------------------------------------------------------
# Copiez en .env, puis lancez ./scripts/bootstrap.sh pour remplir les
# secrets. Ce fichier ne doit JAMAIS être versionné.
# =====================================================================

# ---------------------------------------------------------------------
# OBLIGATOIRE — à remplir à la main
# ---------------------------------------------------------------------
# Le domaine, sans https://. Son enregistrement DNS A doit déjà pointer
# vers l'IP du serveur, sinon Let's Encrypt refusera le certificat.
DOMAIN=file.mon-domaine.fr

# Le même domaine, avec https://. Sert aux liens de plaques, aux URL
# d'invocation de l'App Clip et aux liens des notifications.
SITE_URL=https://file.mon-domaine.fr

# Adresse à laquelle Let's Encrypt préviendra d'un problème de
# certificat. Une vraie adresse que vous relevez.
TLS_EMAIL=vous@mon-domaine.fr

POSTGRES_DB=votretour

# ---------------------------------------------------------------------
# SECRETS — générés par ./scripts/bootstrap.sh
# ---------------------------------------------------------------------
# Ne les changez pas après la mise en service :
#   JWT_SECRET      invaliderait toutes les sessions et les clés
#   SESSION_HASH_SECRET  déconnecterait tous les clients en attente
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
REALTIME_DB_ENC_KEY=
SECRET_KEY_BASE=
SESSION_HASH_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------------
# COURRIEL — facultatif, mais recommandé en production
# ---------------------------------------------------------------------
# Sans serveur d'envoi, MAILER_AUTOCONFIRM=true : les comptes sont
# actifs immédiatement, sans vérification d'adresse, et la
# réinitialisation de mot de passe ne fonctionne pas. Acceptable pour
# essayer, pas pour ouvrir aux clients.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=VotreTour

# ---------------------------------------------------------------------
# NOTIFICATIONS NAVIGATEUR (Android) — npm run keys:vapid
# ---------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@mon-domaine.fr

# ---------------------------------------------------------------------
# APP CLIP iPHONE — facultatif (voir SETUP.md §6 à §11)
# ---------------------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_CLIP_BUNDLE_ID=
APNS_ENVIRONMENT=sandbox
APPLE_APP_ID=
APPLE_CLIP_APP_ID=

# ---------------------------------------------------------------------
# STRIPE — facultatif
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# MÉDIAS — logos et couvertures envoyés depuis le super-admin
# ---------------------------------------------------------------------
# Monté sur le volume media-data : les fichiers survivent aux
# reconstructions de l'image. Sauvegardés par scripts/backup.sh.
MEDIA_ROOT=/app/data/uploads
