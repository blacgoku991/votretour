# =====================================================================
# VotreTour — configuration du serveur
# ---------------------------------------------------------------------
# Copiez en .env, puis lancez ./scripts/bootstrap.sh pour remplir les
# secrets. Ce fichier ne doit JAMAIS être versionné.
# =====================================================================

# ---------------------------------------------------------------------
# OBLIGATOIRE — à remplir à la main
# ---------------------------------------------------------------------
# Le domaine, sans https://. Son enregistrement DNS A doit déjà pointer
# vers l'IP du serveur, sinon Let's Encrypt refusera le certificat.
DOMAIN=file.mon-domaine.fr

# Le même domaine, avec https://. Sert aux liens de plaques, aux URL
# d'invocation de l'App Clip et aux liens des notifications.
SITE_URL=https://file.mon-domaine.fr

# Indexation par les moteurs de recherche. Laissez VIDE en préproduction,
# sur un serveur d'essai ou un banc de démonstration : robots.txt répond
# alors « Disallow: / », sitemap.xml est vide et les pages qui la lisent
# (pages métier) portent « noindex ». Mettez 1 sur la seule production
# (SITE_URL en https). Figé à la compilation dans les pages statiques :
# après l'avoir changé,
#   docker compose build app && docker compose up -d app
# Un simple redémarrage laisserait ces pages en « noindex ».
SEO_INDEXABLE=

# Adresse à laquelle Let's Encrypt préviendra d'un problème de
# certificat. Une vraie adresse que vous relevez.
TLS_EMAIL=vous@mon-domaine.fr

POSTGRES_DB=votretour

# ---------------------------------------------------------------------
# SECRETS — générés par ./scripts/bootstrap.sh
# ---------------------------------------------------------------------
# Ne les changez pas après la mise en service :
#   JWT_SECRET      invaliderait toutes les sessions et les clés
#   SESSION_HASH_SECRET  déconnecterait tous les clients en attente
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
REALTIME_DB_ENC_KEY=
SECRET_KEY_BASE=
SESSION_HASH_SECRET=
CRON_SECRET=

# ---------------------------------------------------------------------
# COURRIEL — facultatif, mais recommandé en production
# ---------------------------------------------------------------------
# Sans serveur d'envoi, MAILER_AUTOCONFIRM=true : les comptes sont
# actifs immédiatement, sans vérification d'adresse, et la
# réinitialisation de mot de passe ne fonctionne pas. Acceptable pour
# essayer, pas pour ouvrir aux clients.
MAILER_AUTOCONFIRM=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Rangvia

# ---------------------------------------------------------------------
# NOTIFICATIONS NAVIGATEUR (Android) — npm run keys:vapid
# ---------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vous@mon-domaine.fr

# ---------------------------------------------------------------------
# APP CLIP iPHONE — facultatif (voir SETUP.md §6 à §11)
# ---------------------------------------------------------------------
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
APNS_CLIP_BUNDLE_ID=
APNS_ENVIRONMENT=sandbox
APPLE_APP_ID=
APPLE_CLIP_APP_ID=
# 1 seulement une fois l'App Clip PUBLIÉ sur l'App Store (pas seulement
# configuré) : les pages publiques peuvent alors le citer. Figé à la
# compilation : après l'avoir changé,
#   docker compose build app && docker compose up -d app
NEXT_PUBLIC_APP_CLIP_PUBLIE=

# ---------------------------------------------------------------------
# STRIPE — facultatif
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# MÉDIAS — logos et couvertures envoyés depuis le super-admin
# ---------------------------------------------------------------------
# Monté sur le volume media-data : les fichiers survivent aux
# reconstructions de l'image. Sauvegardés par scripts/backup.sh.
MEDIA_ROOT=/app/data/uploads

# ---------------------------------------------------------------------
# MENTIONS LÉGALES — à remplir avant d'accueillir des clients payants
# ---------------------------------------------------------------------
# Lues à chaque requête : on les renseigne, puis
# « docker compose up -d app » suffit, sans reconstruire l'image.
# Rien n'est inventé : une valeur vide ne s'affiche pas, et la page
# /mentions-legales n'existe qu'une fois société, adresse, SIRET,
# e-mail et hébergeur renseignés. Les guillemets sont conseillés dès
# qu'une valeur contient des espaces.
#   LEGAL_COMPANY      raison sociale, ou nom de l'entrepreneur individuel
#   LEGAL_FORM         ex. « Entrepreneur individuel », « SAS au capital de 1 000 € »
#   LEGAL_DIRECTOR     directeur·rice de la publication (défaut : la société)
#   LEGAL_HOST_NAME    l'hébergeur du VPS (nom), LEGAL_HOST_ADDRESS son adresse
#   LEGAL_UPDATED_AT   date affichée « Dernière mise à jour » (texte libre)
LEGAL_COMPANY=
LEGAL_FORM=
LEGAL_ADDRESS=
LEGAL_SIRET=
LEGAL_VAT=
LEGAL_DIRECTOR=
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_UPDATED_AT=

# ---------------------------------------------------------------------
# PASSES WALLET — facultatif (voir SETUP.md § 18)
# ---------------------------------------------------------------------
# Sans ces valeurs, aucun bouton Wallet n'apparaît : rien n'est simulé,
# et la carte « Passes Wallet » de /admin dit ce qui manque. Lues au
# démarrage : après les avoir renseignées,
#   docker compose up -d app
# suffit, sans reconstruire l'image.
#
# Apple : les cinq premières lignes sont produites, prêtes à coller, par
#   sh scripts/wallet-apple-import.sh pass.p12
# lancé sur le Mac qui a exporté le certificat Pass Type ID. Une valeur
# par ligne : un PEM saisi à la main se colle encodé en base64
# (base64 < fichier.pem | tr -d '\n'), jamais sur plusieurs lignes.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PEM=
# Facultatif : lu dans le certificat (OU=).
APPLE_WALLET_TEAM_ID=
# Généré par ./scripts/bootstrap.sh s'il est vide. Une fois des passes
# installés, ne le changez plus : ils cesseraient de se mettre à jour.
WALLET_AUTH_SECRET=

# Google : Issuer ID (Google Pay & Wallet Console) et clé JSON du compte
# de service, encodée en base64 sur une ligne (le JSON brut, plein de
# guillemets, se colle mal ici) :  base64 < cle.json | tr -d '\n'
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# demo (comptes de test seulement) | production (après accord de Google)
GOOGLE_WALLET_MODE=demo
# rangvia_staging sur un serveur d'essai : jamais les mêmes classes que
# la production.
GOOGLE_WALLET_CLASS_PREFIX=rangvia
# true seulement après validation en recette.
GOOGLE_WALLET_ROTATING_BARCODE=false
