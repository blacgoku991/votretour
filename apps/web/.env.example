# =====================================================================
# VotreTour — variables d'environnement
# ---------------------------------------------------------------------
# Copiez ce fichier en .env.local pour le développement, et reportez les
# mêmes clés dans les variables d'environnement de Vercel en production.
#
# Tout ce qui est préfixé NEXT_PUBLIC_ est envoyé au navigateur.
# TOUT LE RESTE DOIT LE RESTER : ne préfixez jamais une clé secrète.
# =====================================================================

# ---------------------------------------------------------------------
# NOYAU — obligatoire. Sans ces trois blocs, l'application ne démarre pas.
# ---------------------------------------------------------------------

# Supabase : Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clé de service (service_role). Elle contourne la sécurité au niveau
# ligne : elle ne doit JAMAIS apparaître côté navigateur, ni dans un
# dépôt, ni dans un fichier livré au client.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# URL publique du site. Sert aux liens de plaques, aux URL d'invocation
# de l'App Clip et aux liens dans les notifications.
NEXT_PUBLIC_SITE_URL=https://votretour.app

# Indexation par les moteurs de recherche. Laissez VIDE en local, en
# préproduction et sur les déploiements de prévisualisation (Preview) de
# Vercel : robots.txt répond alors « Disallow: / », sitemap.xml est vide
# et les pages qui la lisent (pages métier) portent « noindex ». Mettez 1
# sur la seule production, en https. Les pages statiques la figent à la compilation : après l'avoir
# changée, redéployez (un nouveau build), pas seulement un redémarrage.
# Par sécurité, une prévisualisation Vercel reste fermée même à 1.
SEO_INDEXABLE=

# Poivre appliqué au hachage des jetons de session client et des
# adresses IP. Générez-le une fois et NE LE CHANGEZ PLUS : le modifier
# invaliderait toutes les sessions clients en cours.
#   openssl rand -base64 48
SESSION_HASH_SECRET=

# ---------------------------------------------------------------------
# WEB PUSH — notifications Android et PWA iOS
# ---------------------------------------------------------------------
# Générez la paire :  npm run keys:vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@votre-domaine.fr

# ---------------------------------------------------------------------
# APNs — notifications de l'App Clip et de l'application iPhone
# ---------------------------------------------------------------------
# Apple Developer → Certificates, Identifiers & Profiles → Keys
# Créez une clé avec le service « Apple Push Notifications » (.p8).
APNS_KEY_ID=
APNS_TEAM_ID=
# Contenu du fichier .p8. Deux formats acceptés :
#   - le PEM complet avec des \n littéraux
#   - le même fichier encodé en base64 :  base64 -i AuthKey_XXXX.p8
APNS_PRIVATE_KEY=
# Bundle ID de l'application complète
APNS_BUNDLE_ID=app.votretour.ios
# Bundle ID de l'APP CLIP : c'est LUI le topic APNs des pushes App Clip.
APNS_CLIP_BUNDLE_ID=app.votretour.ios.Clip
# sandbox pour une build de développement, production pour TestFlight
# et l'App Store.
APNS_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------
# ASSOCIATION DE DOMAINE APPLE
# ---------------------------------------------------------------------
# <TeamID>.<BundleID>, servis dans apple-app-site-association.
APPLE_APP_ID=ABCDE12345.app.votretour.ios
APPLE_CLIP_APP_ID=ABCDE12345.app.votretour.ios.Clip
# 1 seulement une fois l'App Clip PUBLIÉ sur l'App Store (pas seulement
# configuré) : les pages publiques peuvent alors le citer. Figé à la
# compilation : redéployez après l'avoir changé.
NEXT_PUBLIC_APP_CLIP_PUBLIE=

# ---------------------------------------------------------------------
# STRIPE — facultatif. Sans ces clés, tout reste en période d'essai.
# ---------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------
# TÂCHES PLANIFIÉES
# ---------------------------------------------------------------------
# Protège /api/cron/*. Vercel Cron l'envoie en en-tête Authorization.
#   openssl rand -hex 32
CRON_SECRET=

# ---------------------------------------------------------------------
# PASSES WALLET — facultatif (SETUP.md § 18)
# ---------------------------------------------------------------------
# Le client garde son ticket dans Apple Wallet ou Google Wallet, mis à
# jour écran verrouillé. Tant qu'un fournisseur n'est pas entièrement
# renseigné ET valide, aucun bouton n'apparaît côté client ; la carte
# « Passes Wallet » de /admin dit pourquoi. Laisser vide ne casse rien.
#
# Apple : ces cinq lignes sont produites par
#   sh scripts/wallet-apple-import.sh pass.p12
# sur le Mac qui a exporté le certificat. PEM brut (avec des \n
# littéraux) ou base64, comme APNS_PRIVATE_KEY.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_CERT_PEM=
APPLE_WALLET_KEY_PEM=
APPLE_WALLET_KEY_PASSPHRASE=
APPLE_WALLET_WWDR_PEM=
# Facultatif : lu dans le certificat (OU=). À ne renseigner que pour
# forcer une autre valeur.
APPLE_WALLET_TEAM_ID=
# Signe les jetons des passes Apple. Vide : dérivé de SESSION_HASH_SECRET.
# Une fois des passes installés, NE LE CHANGEZ PLUS : ils cesseraient de
# se mettre à jour.   openssl rand -base64 48
WALLET_AUTH_SECRET=

# Google : Issuer ID (Google Pay & Wallet Console) et clé JSON du compte
# de service, brute ou encodée en base64 :  base64 < cle.json | tr -d '\n'
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# demo : seuls les comptes de test déclarés peuvent enregistrer un pass
# (marqué « [TEST ONLY] ») ; production : après l'accord de Google.
GOOGLE_WALLET_MODE=demo
# rangvia_staging en préproduction : deux environnements ne doivent
# jamais partager les mêmes classes.
GOOGLE_WALLET_CLASS_PREFIX=rangvia
# QR tournant des billets d'événement : true seulement après la recette.
GOOGLE_WALLET_ROTATING_BARCODE=false
